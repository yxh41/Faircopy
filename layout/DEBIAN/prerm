#!/bin/sh

LABEL="wiki.qaq.faircopyservices"

for candidate in /var/containers/Bundle/Application/.jbroot-*/Library/LaunchDaemons/$LABEL.plist \
                 /var/jb/Library/LaunchDaemons/$LABEL.plist \
                 /Library/LaunchDaemons/$LABEL.plist; do
	[ -f "$candidate" ] && launchctl unload -w "$candidate" > /dev/null 2>&1
done

killall -9 AIGate > /dev/null 2>&1

# The heart beat says "a resident worker is answering requests". It is treated as
# valid for 15 s, so leaving it behind would make the app step aside for a worker
# that is no longer there — every hand-off would then wait for an answer that
# never comes.
rm -f /var/mobile/Library/Preferences/wiki.qaq.ai.gate/faircopy_ocr_daemon.json

# 3.0.128: the same argument for the hand-off stamp. It says "this picture was
# already read", and a leftover one would make the next visible launch skip a
# picture nobody read, i.e. a tap that does nothing.
rm -f /var/mobile/Library/Preferences/wiki.qaq.ai.gate/faircopy_ocr_finished.json

exit 0
